# MAX Bot (business.max.ru → Чат-боты)
MAX_BOT_TOKEN=

MAX_MODE=polling
MAX_WEBHOOK_SECRET=
MAX_WEBHOOK_HOST=0.0.0.0
MAX_WEBHOOK_PORT=8080
MAX_ROOT_CA_PATH=deploy/russian_trusted_root_ca.pem

# GigaChat (поиск книг с grounding по каталогу)
GIGACHAT_ENABLED=false
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# CSV «Список книг» (разделитель ; ) — боевой файл от заказчика
BOOKS_CSV_PATH=assets/books_sample.csv

STORAGE_PATH=data
LOG_LEVEL=INFO
